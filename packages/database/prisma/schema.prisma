generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Environment {
  TEST
  LIVE
}

enum PaymentIntentStatus {
  REQUIRES_PAYMENT_METHOD
  REQUIRES_CONFIRMATION
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  CANCELED
  FAILED
}

enum PaymentStatus {
  PROCESSING
  SUCCEEDED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum LedgerEntryDirection {
  DEBIT
  CREDIT
}

enum SettlementStatus {
  PENDING
  PAID
  FAILED
}

enum RiskRuleType {
  AMOUNT_GTE
  REFERENCE_CONTAINS
}

enum RiskAction {
  BLOCK
  REVIEW
}

enum RiskOutcome {
  ALLOWED
  REVIEW
  BLOCKED
}

enum SubscriptionInterval {
  DAY
  WEEK
  MONTH
  YEAR
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String
  memberships     MerchantUser[]
  sessions        Session[]
  auditLogs       AuditLog[]
  teamInvitesSent TeamInvite[]     @relation("TeamInviteInviter")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Merchant {
  id               String            @id @default(cuid())
  name             String
  country          String            @default("LK")
  defaultCurrency  String            @default("LKR")
  memberships      MerchantUser[]
  sessions         Session[]
  apiKeys          ApiKey[]
  customers        Customer[]
  paymentIntents   PaymentIntent[]
  payments         Payment[]
  refunds          Refund[]
  subscriptions    Subscription[]
  invoices         Invoice[]
  webhookEndpoints WebhookEndpoint[]
  ledgerAccounts   LedgerAccount[]
  settlements      Settlement[]
  auditLogs        AuditLog[]
  teamInvites      TeamInvite[]
  apiRequestLogs   ApiRequestLog[]
  riskRules        RiskRule[]
  riskEvents       RiskEvent[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model MerchantUser {
  id         String   @id @default(cuid())
  userId     String
  merchantId String
  role       String   @default("OWNER")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, merchantId])
  @@index([merchantId])
}

model TeamInvite {
  id              String    @id @default(cuid())
  merchantId      String
  invitedByUserId String?
  email           String
  role            String    @default("VIEWER")
  tokenHash       String    @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  merchant        Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  invitedBy       User?     @relation("TeamInviteInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())

  @@index([merchantId, createdAt])
  @@index([email])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  merchantId String
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([merchantId])
  @@index([expiresAt])
}

model ApiKey {
  id          String      @id @default(cuid())
  merchantId  String
  environment Environment @default(TEST)
  name        String
  prefix      String
  keyHash     String      @unique
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  merchant    Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@index([merchantId, environment])
}

model ApiRequestLog {
  id         String   @id @default(cuid())
  merchantId String
  requestId  String
  method     String
  path       String
  status     Int
  source     String
  durationMs Int
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([merchantId, createdAt])
  @@index([requestId])
}

model Customer {
  id            String          @id @default(cuid())
  merchantId    String
  name          String?
  email         String?
  phone         String?
  metadata      Json?
  merchant      Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  intents       PaymentIntent[]
  subscriptions Subscription[]
  invoices      Invoice[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([merchantId, email])
  @@index([merchantId, createdAt])
}

model PaymentIntent {
  id                String              @id @default(cuid())
  merchantId        String
  customerId        String?
  environment       Environment         @default(TEST)
  amount            BigInt
  currency          String              @default("LKR")
  status            PaymentIntentStatus @default(REQUIRES_PAYMENT_METHOD)
  merchantReference String?
  description       String?
  checkoutToken     String              @unique
  idempotencyKey    String?
  metadata          Json?
  actionToken       String?
  actionCardBrand   String?
  actionCardLast4   String?
  merchant          Merchant            @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  customer          Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  invoice           Invoice?
  payments          Payment[]
  riskEvents        RiskEvent[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([merchantId, idempotencyKey])
  @@index([merchantId, createdAt])
  @@index([customerId])
}

model Payment {
  id              String        @id @default(cuid())
  merchantId      String
  paymentIntentId String
  amount          BigInt
  refundedAmount  BigInt        @default(0)
  currency        String
  status          PaymentStatus @default(PROCESSING)
  processor       String        @default("DEMO")
  processorRef    String?
  cardBrand       String?
  cardLast4       String?
  failureCode     String?
  failureMessage  String?
  merchant        Merchant      @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  paymentIntent   PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  refunds         Refund[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([merchantId, createdAt])
  @@index([paymentIntentId])
}

model Refund {
  id         String       @id @default(cuid())
  merchantId String
  paymentId  String
  amount     BigInt
  currency   String
  status     RefundStatus @default(PENDING)
  reason     String?
  merchant   Merchant     @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  payment    Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([merchantId, createdAt])
  @@index([paymentId])
}

model Subscription {
  id                  String               @id @default(cuid())
  merchantId          String
  customerId          String
  amount              BigInt
  currency            String               @default("LKR")
  interval            SubscriptionInterval
  intervalCount       Int                  @default(1)
  description         String?
  status              SubscriptionStatus   @default(ACTIVE)
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  nextBillingAt       DateTime
  cancelAtPeriodEnd   Boolean              @default(false)
  canceledAt          DateTime?
  merchant            Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invoices            Invoice[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([merchantId, createdAt])
  @@index([customerId])
  @@index([merchantId, nextBillingAt])
}

model Invoice {
  id              String        @id @default(cuid())
  merchantId      String
  customerId      String
  subscriptionId  String?
  paymentIntentId String?       @unique
  amountDue       BigInt
  amountPaid      BigInt        @default(0)
  currency        String
  status          InvoiceStatus @default(DRAFT)
  description     String?
  periodStart     DateTime
  periodEnd       DateTime
  dueAt           DateTime?
  paidAt          DateTime?
  merchant        Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  paymentIntent   PaymentIntent? @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([merchantId, createdAt])
  @@index([customerId])
  @@index([subscriptionId])
  @@index([merchantId, status])
}

model WebhookEndpoint {
  id         String            @id @default(cuid())
  merchantId String
  url        String
  secret     String
  enabled    Boolean           @default(true)
  merchant   Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([merchantId])
}

model WebhookDelivery {
  id          String                @id @default(cuid())
  endpointId  String
  eventId     String
  eventType   String
  payload     Json
  status      WebhookDeliveryStatus @default(PENDING)
  attempts    Int                   @default(0)
  lastError   String?
  deliveredAt DateTime?
  endpoint    WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([endpointId, createdAt])
}

model LedgerAccount {
  id         String        @id @default(cuid())
  merchantId String?
  code       String
  name       String
  currency   String        @default("LKR")
  merchant   Merchant?     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  entries    LedgerEntry[]
  createdAt  DateTime      @default(now())

  @@unique([merchantId, code, currency])
}

model LedgerEntry {
  id            String               @id @default(cuid())
  transactionId String
  accountId     String
  direction     LedgerEntryDirection
  amount        BigInt
  currency      String
  referenceType String
  referenceId   String
  account       LedgerAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdAt     DateTime             @default(now())

  @@index([transactionId])
  @@index([accountId, createdAt])
}

model Settlement {
  id         String           @id @default(cuid())
  merchantId String
  amount     BigInt
  currency   String
  status     SettlementStatus @default(PENDING)
  periodFrom DateTime
  periodTo   DateTime
  merchant   Merchant         @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([merchantId, createdAt])
}

model RiskRule {
  id         String       @id @default(cuid())
  merchantId String
  name       String
  type       RiskRuleType
  action     RiskAction   @default(BLOCK)
  threshold  BigInt?
  textValue  String?
  currency   String?
  enabled    Boolean      @default(true)
  merchant   Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  events     RiskEvent[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([merchantId, enabled])
}

model RiskEvent {
  id                String         @id @default(cuid())
  merchantId        String
  ruleId            String?
  paymentIntentId   String?
  outcome           RiskOutcome
  reason            String
  amount            BigInt
  currency          String
  merchantReference String?
  merchant          Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  rule              RiskRule?      @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  paymentIntent     PaymentIntent? @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now())

  @@index([merchantId, createdAt])
  @@index([ruleId])
  @@index([paymentIntentId])
}

model AuditLog {
  id         String    @id @default(cuid())
  merchantId String
  userId     String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  merchant   Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())

  @@index([merchantId, createdAt])
  @@index([userId, createdAt])
}
