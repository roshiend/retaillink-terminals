# Public HTTPS endpoints
PUBLIC_API_URL="https://api.example.com"
CHECKOUT_BASE_URL="https://checkout.example.com"
DASHBOARD_ORIGIN="https://dashboard.example.com"

# Use a managed PostgreSQL instance with TLS required by your provider.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/retaillink?schema=public&sslmode=require"

# Required write-safety controls
REQUIRE_IDEMPOTENCY_KEYS="true"
ENABLE_RATE_LIMIT="true"
TRUST_PROXY="true"
MAX_BODY_BYTES="1048576"
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_AUTH_MAX="30"
RATE_LIMIT_PUBLIC_MAX="120"
RATE_LIMIT_API_MAX="300"

# Never commit real credentials. Inject secrets from the deployment platform or secret manager.
